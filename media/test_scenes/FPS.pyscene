# ------------------------------------------------------------
# 6. 조명
# ------------------------------------------------------------

dirLight = DistantLight('Sun')
dirLight.direction = float3(0, -1, 0)  # 정확히 수직 아래
dirLight.intensity = float3(5, 5, 5)
dirLight.angle = 0.1
sceneBuilder.addLight(dirLight)

# ------------------------------------------------------------
# 7. 오브젝트 애니메이션 (2-2)
# ------------------------------------------------------------

# 적 구체: x축으로 좌우 왕복 (-1.8 ~ +1.8), 4초 주기
enemyAnim = Animation("enemy_patrol", enemyNodeID, 4.0)
enemyAnim.postInfinityBehavior = Animation.Behavior.Cycle
enemyAnim.interpolationMode = Animation.InterpolationMode.Linear
enemyAnim.addKeyframe(0.0, Transform(translation=float3( 0.0, 1.7, 2.0)))
enemyAnim.addKeyframe(2.0, Transform(translation=float3( 1.8, 1.7, 2.0)))
enemyAnim.addKeyframe(4.0, Transform(translation=float3( 0.0, 1.7, 2.0)))
sceneBuilder.addAnimation(enemyAnim)


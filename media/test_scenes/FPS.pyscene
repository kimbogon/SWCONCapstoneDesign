from falcor import *

# ------------------------------------------------------------
# 1. 메시 생성
# ------------------------------------------------------------
quadMesh   = TriangleMesh.createQuad() # 2D 평면
cubeMesh   = TriangleMesh.createCube() # 3D 입체
sphereMesh   = TriangleMesh.createSphere(radius=0.4)

# ------------------------------------------------------------
# 2. 머티리얼 생성
# ------------------------------------------------------------
matFloor = StandardMaterial('Floor')            # 머터리얼 객체 선언
matFloor.baseColor = float4(0.6, 0.6, 0.6, 1.0) # baseColor 속성 지정
matFloor.roughness = 0.8                        # roughness 속성 지정

matWall = StandardMaterial('Wall')
matWall.baseColor = float4(0.7, 0.7, 0.7, 1.0)
matWall.roughness = 0.9

matEnemy = StandardMaterial('Enemy')
matEnemy.baseColor = float4(0.9, 0.2, 0.2, 1.0)   # 빨간 구
matEnemy.roughness = 0.3
# matEnemy.metallic  = 0.6

matGreen = StandardMaterial('GreenCube')
matGreen.baseColor = float4(0.1, 0.8, 0.2, 1.0)
matGreen.roughness = 0.5

matBlue = StandardMaterial('BlueCube')
matBlue.baseColor = float4(0.1, 0.3, 0.9, 1.0)
matBlue.roughness = 0.5

# ------------------------------------------------------------
# 3. 메시를 SceneBuilder에 등록
# ------------------------------------------------------------
floorMeshID = sceneBuilder.addTriangleMesh(quadMesh, matFloor) # 메시 + 머터리얼을 인자로 넣어 등록
wallMeshID = sceneBuilder.addTriangleMesh(cubeMesh, matWall)
sphereMeshID = sceneBuilder.addTriangleMesh(sphereMesh, matEnemy)
greenCubeMeshID = sceneBuilder.addTriangleMesh(cubeMesh, matGreen)
blueCubeMeshID = sceneBuilder.addTriangleMesh(cubeMesh, matBlue)

# ------------------------------------------------------------
# 4. 노드 추가 + 메시 인스턴스 연결
# ------------------------------------------------------------
# 노드는 Transform을 지정
# Node ID + Mesh ID를 인자로 넣어 메시를 씬에 추가

# 바닥: 20*20
floorNodeID = sceneBuilder.addNode('floor', Transform(
    scaling=float3(20, 0.1, 20),
    translation=float3(0, 0, 0)
))
sceneBuilder.addMeshInstance(floorNodeID, floorMeshID)

# 왼쪽 벽
wallLNodeID = sceneBuilder.addNode('wall_left', Transform(
    scaling=float3(0.2, 3, 20),
    translation=float3(-10, 1.5, 0)
))
sceneBuilder.addMeshInstance(wallLNodeID, wallMeshID)

# 오른쪽 벽
wallRNodeID = sceneBuilder.addNode('wall_right', Transform(
    scaling=float3(0.2, 3, 20),
    translation=float3(10, 1.5, 0)
))
sceneBuilder.addMeshInstance(wallRNodeID, wallMeshID)

# 뒤 벽
wallBNodeID = sceneBuilder.addNode('wall_back', Transform(
    scaling=float3(20, 3, 0.2),
    translation=float3(0, 1.5, -10)
))
sceneBuilder.addMeshInstance(wallBNodeID, wallMeshID)

# 코너 벽
cornerNodeID = sceneBuilder.addNode('corner_wall', Transform(
    scaling=float3(20, 3, 0.2),
    translation=float3(0, 1.5, 10)
))
sceneBuilder.addMeshInstance(cornerNodeID, wallMeshID)

# 펜스
fenceNodeID = sceneBuilder.addNode('fence', Transform(
    scaling=float3(20, 1, 1),
    translation=float3(0, 0, 0)
))
sceneBuilder.addMeshInstance(fenceNodeID, wallMeshID)

# 구형 적 오브젝트
# 카메라: position=(0,1.7,-5), target=(0,1.7,0), focalLength=21
# z=2 에 배치하면 카메라 정면 시야 중앙에 위치
# 벽이 x=-3 ~ x=3 이므로 좌우 진폭은 ±1.8 으로 여유있게 설정
# 초기 위치: 중앙, 눈높이(y=1.7), z=2 (카메라 정면)
enemyNodeID = sceneBuilder.addNode('enemy', Transform(
    translation=float3(0, 1.7, 2)
))
sceneBuilder.addMeshInstance(enemyNodeID, sphereMeshID)

# 초록색 큐브 
greenCubeNodeID = sceneBuilder.addNode('cube_green', Transform(
    scaling=float3(0.5, 0.5, 0.5),
    translation=float3(-7, 0.25, -2)
))
sceneBuilder.addMeshInstance(greenCubeNodeID, greenCubeMeshID)

# 파란색 큐브 
blueCubeNodeID = sceneBuilder.addNode('cube_blue', Transform(
    scaling=float3(0.5, 0.5, 0.5),
    translation=float3(-7, 0.25, -5)
))
sceneBuilder.addMeshInstance(blueCubeNodeID, blueCubeMeshID)

# ------------------------------------------------------------
# 5. 카메라
# ------------------------------------------------------------
camera = Camera('MainCamera')
camera.position    = float3(0, 1.7, -5)
camera.target      = float3(0, 1.7, 10)
camera.up          = float3(0, 1, 0)
camera.focalLength = 21
sceneBuilder.addCamera(camera)

#_cam_anim = sceneBuilder.createAnimation(camera, 'recorded', 86400.0000)

# 여기에 keyframe 삽입

#_cam_anim.postInfinityBehavior = Animation.Behavior.Constant

# ------------------------------------------------------------
# 6. 조명
# ------------------------------------------------------------

dirLight = DistantLight('Sun')
dirLight.direction = float3(0, -1, 0)  # 정확히 수직 아래
dirLight.intensity = float3(5, 5, 5)
dirLight.angle = 0.1
sceneBuilder.addLight(dirLight)

# ------------------------------------------------------------
# 7. 오브젝트 애니메이션
# ------------------------------------------------------------

# 적 구체: x축으로 좌우 왕복 
enemyAnim = Animation("enemy_patrol", enemyNodeID, 8.0) # 여기서 애니메이션 주기를 입력해야 함
enemyAnim.postInfinityBehavior = Animation.Behavior.Cycle
enemyAnim.interpolationMode = Animation.InterpolationMode.Linear
enemyAnim.addKeyframe(0.0, Transform(translation=float3( 0.0, 1.7, 2.0)))
enemyAnim.addKeyframe(2.0, Transform(translation=float3( 2.0, 1.7, 2.0)))
enemyAnim.addKeyframe(4.0, Transform(translation=float3( 0.0, 1.7, 2.0)))
enemyAnim.addKeyframe(6.0, Transform(translation=float3( -2.0, 1.7, 2.0)))
enemyAnim.addKeyframe(8.0, Transform(translation=float3( 0.0, 1.7, 2.0)))
sceneBuilder.addAnimation(enemyAnim)

# ------------------------------------------------------------
# 8. 카메라 자동 궤적
#    CAMERA_ANIMATION 매크로에 따라 한 애니메이션만 등록
# ------------------------------------------------------------

# ============================================================
# 매크로 변수: 재생할 카메라 애니메이션 선택
#   'aiming'   — camera_aiming.py 시나리오 재생
#   'pointing' — camera_pointing_steering.py 시나리오 재생
#   'none'     — 카메라 애니메이션 없음
# ============================================================
CAMERA_ANIMATION = 'pointing'

_up = float3(0, 1, 0)

if CAMERA_ANIMATION == 'aiming':
    # ============================================================
    # Aiming 시나리오  (camera_aiming.py)
    #   0 ~ 4초 : 카메라 (0,1.7,-9) → (0,1.7,-1) 전진하며 적 추적
    #   4 ~10초 : 카메라 (0,1.7,-1) 고정, 적 지속 추적
    # ============================================================
    _cam_anim = sceneBuilder.createAnimation(camera, 'aiming_trajectory', 10.0)
    _cam_anim.postInfinityBehavior = Animation.Behavior.Constant
    _cam_anim.interpolationMode = Animation.InterpolationMode.Linear

    # ---------- 0~4초: 전진 구간 (카메라 z: -9 → -1) ----------
    # t=0: enemy_x= 0.0, cam_z=-9
    _cam_anim.addKeyframe(0.0, Transform(
        position=float3(0, 1.7, -9),
        target=float3( 0.0, 1.7, 2.0),
        up=_up))
    # t=1: enemy_x= 1.0, cam_z=-7
    _cam_anim.addKeyframe(1.0, Transform(
        position=float3(0, 1.7, -7),
        target=float3( 0.0, 1.7, 2.0),
        up=_up))
    # t=2: enemy_x= 2.0, cam_z=-5  ← 적 방향전환 (우→중앙)
    _cam_anim.addKeyframe(2.0, Transform(
        position=float3(0, 1.7, -5),
        target=float3( 0.0, 1.7, 2.0),
        up=_up))
    # t=3: enemy_x= 1.0, cam_z=-3
    _cam_anim.addKeyframe(3.0, Transform(
        position=float3(0, 1.7, -3),
        target=float3( 0.0, 1.7, 2.0),
        up=_up))
    # t=4: enemy_x= 0.0, cam_z=-1  ← 카메라 전진 완료 / 적 방향전환 (중앙→좌)
    _cam_anim.addKeyframe(4.0, Transform(
        position=float3(0, 1.7, -1),
        target=float3( 0.0, 1.7, 2.0),
        up=_up))

    # ---------- 4~10초: 고정 구간 (카메라 (0,1.7,-1) 유지) ----------
    # t=5: enemy_x=-1.0
    _cam_anim.addKeyframe(5.0, Transform(
        position=float3(0, 1.7, -1),
        target=float3(-1.0, 1.7, 2.0),
        up=_up))
    # t=6: enemy_x=-2.0  ← 적 방향전환 (좌→중앙)
    _cam_anim.addKeyframe(6.0, Transform(
        position=float3(0, 1.7, -1),
        target=float3(-2.0, 1.7, 2.0),
        up=_up))
    # t=7: enemy_x=-1.0
    _cam_anim.addKeyframe(7.0, Transform(
        position=float3(0, 1.7, -1),
        target=float3(-1.0, 1.7, 2.0),
        up=_up))
    # t=8: enemy_x= 0.0  ← 적 8초 주기 재시작 (중앙→우)
    _cam_anim.addKeyframe(8.0, Transform(
        position=float3(0, 1.7, -1),
        target=float3( 0.0, 1.7, 2.0),
        up=_up))
    # t=9: enemy_x= 1.0
    _cam_anim.addKeyframe(9.0, Transform(
        position=float3(0, 1.7, -1),
        target=float3( 1.0, 1.7, 2.0),
        up=_up))
    # t=10: enemy_x= 2.0  ← 적 방향전환 (우→중앙), 1주기 종료
    _cam_anim.addKeyframe(10.0, Transform(
        position=float3(0, 1.7, -1),
        target=float3( 2.0, 1.7, 2.0),
        up=_up))

    sceneBuilder.addAnimation(_cam_anim)

elif CAMERA_ANIMATION == 'pointing':
    # ============================================================
    # Pointing + Steering 시나리오  (camera_pointing_steering.py)
    #   0 ~ 3초 : 카메라 (0,1.7,-8) → (0,1.7,-2) 전진 (Steering)
    #   3 ~ 4초 : (0,1.7,-2) 고정, -x 방향으로 90° 회전
    #   4 ~ 7초 : 카메라 (0,1.7,-2) → (-6,1.7,-2) 측면 이동 (Steering)
    #   7 ~10초 : (-6,1.7,-2) 고정, 아래로 회전하여 초록 큐브 조준 (Pointing)
    # ============================================================
    _cam_anim = sceneBuilder.createAnimation(camera, 'pointing_steering_trajectory', 10.0)
    _cam_anim.postInfinityBehavior = Animation.Behavior.Constant
    _cam_anim.interpolationMode = Animation.InterpolationMode.Linear

    # ---------- 0~3초: 전진 구간 (Steering) ----------
    # t=0: pos=(0,1.7,-8), 전방 +z
    _cam_anim.addKeyframe(0.0, Transform(
        position=float3( 0, 1.7, -8),
        target=float3(  0, 1.7,  2),
        up=_up))
    # t=3: pos=(0,1.7,-2), 전진 완료
    _cam_anim.addKeyframe(3.0, Transform(
        position=float3( 0, 1.7, -2),
        target=float3(  0, 1.7,  8),
        up=_up))

    # ---------- 3~4초: 회전 구간 (-x 방향 전환) ----------
    # t=4: pos=(0,1.7,-2), 전방 -x (이후 이동 방향과 일치)
    _cam_anim.addKeyframe(4.0, Transform(
        position=float3(  0, 1.7, -2),
        target=float3( -10, 1.7, -2),
        up=_up))

    # ---------- 4~7초: 측면 이동 구간 (Steering) ----------
    # t=7: pos=(-6,1.7,-2), 이동 완료
    _cam_anim.addKeyframe(7.0, Transform(
        position=float3( -6, 1.7, -2),
        target=float3( -10, 1.7, -2),
        up=_up))

    # ---------- 7~10초: 하향 회전 구간 (Pointing) ----------
    # t=8: 초록 큐브 정조준, 카메라 정지
    _cam_anim.addKeyframe(8.0, Transform(
        position=float3(-6, 1.7, -2),
        target=float3( -7, 0.25, -2),
        up=_up))
    # t=10: 초록 큐브 정조준, 카메라 정지
    _cam_anim.addKeyframe(10.0, Transform(
        position=float3(-6, 1.7, -2),
        target=float3( -7, 0.25, -2),
        up=_up))

    sceneBuilder.addAnimation(_cam_anim)

# CAMERA_ANIMATION == 'none' 이면 카메라 애니메이션을 등록하지 않음
